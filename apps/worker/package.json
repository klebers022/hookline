{
  "name": "@hookline/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.d.ts"
  ],
  "dependencies": {
    "@hookline/shared": "workspace:*",
    "amqplib": "^2.2.1",
    "pino": "^10.4.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "@hookline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "dev:relay": "tsx watch --conditions=@hookline/source --env-file-if-exists=../../.env src/main-relay.ts",
    "dev:deliver": "tsx watch --conditions=@hookline/source --env-file-if-exists=../../.env src/main-deliver.ts"
  }
}
