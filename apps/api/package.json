{
  "name": "@hookline/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@hookline/shared": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "exports": {
    ".": {
      "@hookline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@hookline/source --env-file-if-exists=../../.env src/server.ts",
    "migrate": "tsx --conditions=@hookline/source --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "project:create": "tsx --conditions=@hookline/source --env-file-if-exists=../../.env src/scripts/create-project.ts"
  }
}
