        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_queue_messages{queue=\"deliveries.dlq\"})"
        }
      ]
    },
    {
      "type": "row",
