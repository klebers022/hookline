      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(hookline_outbox_oldest_pending_age_seconds)"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
