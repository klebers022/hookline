# Local development defaults. Copy to .env to override them.
POSTGRES_USER=hookline
POSTGRES_PASSWORD=hookline
POSTGRES_DB=hookline
RABBITMQ_USER=hookline
RABBITMQ_PASSWORD=hookline

DATABASE_URL=postgres://hookline:hookline@localhost:5432/hookline
RABBITMQ_URL=amqp://hookline:hookline@localhost:5672

# Development only. Generate your own for any shared environment.
ENCRYPTION_KEY=R/4NcjA3LApFWpimRkDtKcOD8JvYI0CMF2Q5RzJIyuA=

# Wait before each attempt after the first. Use shorter values to test locally.
RETRY_DELAYS=1m,5m,30m,2h,6h

# Lets endpoints use http and private addresses, such as the local test
# receiver. Never enable it where third parties can register endpoints.
ALLOW_PRIVATE_TARGETS=true

# Webhooks sent per second to each endpoint, per worker process.
ENDPOINT_RATE_LIMIT_PER_SECOND=50

# API requests allowed per project, per API process.
RATE_LIMIT_PER_MINUTE=6000

# Port for /metrics, /healthz and /readyz. Each process defaults to its own
# (API 9464, relay 9465, delivery worker 9466), so they can run side by side.
# METRICS_PORT=9464
# Address the ops port listens on. Keep it private.
# METRICS_HOST=127.0.0.1
