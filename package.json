{
  "name": "hookline",
  "version": "0.0.0",
  "private": true,
  "description": "Reliable webhook delivery platform",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:down": "docker compose --profile app down",
    "stack:smoke": "node scripts/smoke.mjs",
    "obs:up": "docker compose --profile observability up -d --wait prometheus tempo grafana",
    "obs:down": "docker compose --profile observability rm --stop --force prometheus tempo grafana",
    "db:migrate": "pnpm --filter @hookline/api migrate",
    "project:create": "pnpm --filter @hookline/api project:create",
    "dev:api": "pnpm --filter @hookline/api dev",
    "dev:relay": "pnpm --filter @hookline/worker dev:relay",
    "dev:deliver": "pnpm --filter @hookline/worker dev:deliver",
    "dev:receiver": "pnpm --filter @hookline/test-receiver dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
