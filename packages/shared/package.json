{
  "name": "@hookline/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "@hookline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "@hookline/source": "./src/telemetry/tracing.ts",
      "types": "./dist/telemetry/tracing.d.ts",
      "default": "./dist/telemetry/tracing.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.3"
  }
}
